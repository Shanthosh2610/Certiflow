{
  "name": "certiflow-backend",
  "version": "1.0.0",
  "description": "Backend API for CertiFlow Certificate Issuance Platform",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test:upload-validation": "ts-node src/test-upload-validation.ts",
    "test:certificate-issuance": "ts-node src/test-certificate-issuance.ts",
    "test:certificate-delivery": "ts-node src/test-certificate-delivery.ts",
    "test:approval-workflow": "ts-node src/test-approval-workflow.ts",
    "test:milestone9": "ts-node src/test-milestone9.ts",
    "test:critical-scenarios": "ts-node src/test-critical-scenarios.ts",
    "test:all": "npm run test:upload-validation && npm run test:approval-workflow && npm run test:certificate-issuance && npm run test:certificate-delivery && npm run test:milestone9 && npm run test:critical-scenarios",
    "db:reset": "prisma db push --force-reset && ts-node prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.29.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ioredis": "^5.4.1",
    "multer": "^2.5.0",
    "pdfkit": "^0.21.0",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
