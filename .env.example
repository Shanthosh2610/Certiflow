# Docker Compose demo defaults only. Change credentials before any shared deployment.
POSTGRES_USER=certiflow_user
POSTGRES_PASSWORD=certiflow_pass
POSTGRES_DB=certiflow_db
DATABASE_URL=postgresql://certiflow_user:certiflow_pass@postgres:5432/certiflow_db?schema=public

# Public browser origin and API URL used by the built frontend.
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000

# Demo-only placeholder; use a high-entropy secret in any non-demo environment.
JWT_SECRET=demo-only-change-me

# Operational controls.
BATCH_OVERDUE_HOURS=48
SEED_DEMO_DATA=true
WHATSAPP_SIMULATED_FAILURE_RATE=0.2
WHATSAPP_SIMULATED_TIMEOUT_RATE=0.1

# Optional host-side port overrides when defaults are already occupied.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=5000
FRONTEND_HOST_PORT=5173
